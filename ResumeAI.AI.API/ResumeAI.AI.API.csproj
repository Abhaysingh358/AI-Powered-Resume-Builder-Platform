<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ResumeAI.AI</RootNamespace>
    <AssemblyName>ResumeAI.AI.API</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- PostgreSQL / EF Core -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"               Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"                 Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools"                  Version="8.0.11" />

    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"        Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt"                     Version="8.3.3"  />

    <!-- OpenAI -->
    <PackageReference Include="OpenAI"                                               Version="2.1.0"  />

    <!-- Anthropic Claude -->
    <PackageReference Include="Anthropic.SDK"                                        Version="3.4.3"  />

    <!-- Redis for quota counters -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis"     Version="8.0.11" />

    <!-- HTML Sanitizer to prevent prompt injection -->
    <PackageReference Include="HtmlSanitizer"                                        Version="8.1.870"/>

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore"                              Version="6.9.0"  />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore"                                   Version="8.0.3"  />
    <PackageReference Include="Serilog.Sinks.Console"                               Version="6.0.0"  />

    <!-- Mapping -->
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection"  Version="12.0.1" />

    <!-- Polly for retry + failover between OpenAI and Claude -->
    <PackageReference Include="Polly"                                                Version="8.5.2"  />
    <PackageReference Include="Microsoft.Extensions.Http.Polly"                     Version="8.0.1"  />
  </ItemGroup>

</Project>
