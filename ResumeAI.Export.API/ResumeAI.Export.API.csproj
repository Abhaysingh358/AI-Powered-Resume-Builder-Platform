<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ResumeAI.Export</RootNamespace>
    <AssemblyName>ResumeAI.Export.API</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- PostgreSQL / EF Core -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"               Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"                 Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools"                  Version="8.0.11" />

    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"        Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt"                     Version="8.3.3"  />

    <!-- PDF Generation -->
    <PackageReference Include="QuestPDF"                                             Version="2024.10.4" />

    <!-- DOCX Generation -->
    <PackageReference Include="DocumentFormat.OpenXml"                              Version="3.2.0"  />

    <!-- MassTransit + RabbitMQ -->
    <PackageReference Include="MassTransit"                                          Version="8.3.6"  />
    <PackageReference Include="MassTransit.RabbitMQ"                                Version="8.3.6"  />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore"                              Version="6.9.0"  />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore"                                   Version="8.0.3"  />
    <PackageReference Include="Serilog.Sinks.Console"                               Version="6.0.0"  />

    <!-- Mapping -->
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection"  Version="12.0.1" />
  </ItemGroup>

</Project>
