{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "resume-route": {
        "ClusterId": "resume-cluster",
        "Match": {
          "Path": "/api/resumes/{**catch-all}"
        }
      },
      "section-route": {
        "ClusterId": "section-cluster",
        "Match": {
          "Path": "/api/sections/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      },
      "template-route": {
        "ClusterId": "template-cluster",
        "Match": {
          "Path": "/api/templates/{**catch-all}"
        }
      },
      "export-route": {
        "ClusterId": "export-cluster",
        "Match": {
          "Path": "/api/exports/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5169"
          }
        }
      },
      "resume-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "section-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5106"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5107"
          }
        }
      },
      "template-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5108"
          }
        }
      },
      "export-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5109"
          }
        }
      }
    }
  }
}
